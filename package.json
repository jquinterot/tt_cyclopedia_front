{
  "name": "react_basics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "unit:test": "vitest",
    "component:test": "npx cypress run --component",
    "e2e:test": "cd e2e && npx playwright test",
    "e2e:test:install": "cd e2e && npm install && npx playwright install chromium",
    "test:all": "npm run unit:test -- --run && npm run component:test && npm run e2e:test",
    "prepush": "npm run format:check && npm run lint && npm run unit:test -- --run && npm run component:test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-devtools": "^5.100.5",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.3.5",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "vitest": "^1.6.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.19",
    "cypress": "^15.14.2",
    "cypress-file-upload": "^5.0.8",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.0",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "zustand": "^5.0.12"
  }
}
